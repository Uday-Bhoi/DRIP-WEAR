rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow user to read and write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow user to manage their sub-collections (wardrobe_items, outfits, preferences)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
